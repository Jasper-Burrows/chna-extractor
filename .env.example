# Copy to .env for local development. Never commit real credentials.
CHNA_ENVIRONMENT=development
CHNA_DATABASE_PATH=.data/chna.db
CHNA_UPLOAD_DIR=.data/uploads
CHNA_FRONTEND_DIST=web/dist
CHNA_MAX_UPLOAD_MB=25
CHNA_MAX_PDF_PAGES=500
CHNA_MAX_CONCURRENT_JOBS=2
CHNA_RETAIN_UPLOADED_FILES=false
CHNA_ENABLE_OCR=false
CHNA_OCR_TIMEOUT_SECONDS=45
CHNA_OPENAI_API_KEY=
CHNA_OPENAI_MODEL=gpt-5.6-terra
CHNA_OPENAI_TIMEOUT_SECONDS=90
CHNA_SAFETY_IDENTIFIER_SEED=
# Defaults reflect gpt-5.6-terra pricing; override alongside a model change.
CHNA_INPUT_COST_PER_MILLION=2.50
CHNA_CACHED_INPUT_COST_PER_MILLION=0.25
CHNA_OUTPUT_COST_PER_MILLION=15.00
CHNA_ENABLE_GOOGLE_MAPS=false
CHNA_GOOGLE_MAPS_API_KEY=
CHNA_ENABLE_WEB_SEARCH=false
# Conservative per-call reserve includes provider search-tool charges beyond tokens.
CHNA_WEB_SEARCH_RESERVE_USD=0.10
CHNA_WEB_SEARCH_MAX_RECORDS=10
CHNA_WEB_SEARCH_MAX_TOOL_CALLS=3
CHNA_TOTAL_BUDGET_USD=10.00
